this.toggleStateClass(true, seoTitleAiElement, 'seo-ai-hidden')
},
applySeoDesc: function () {
const seoDescAiElement = document.querySelector('.js-ai-generated-seo-desc')
const seoDescInput = document.querySelector('.js-seo-textfield.js-seo-desc')

seoDescInput.value = productSeoAiAssistantHandler.generatedSeoDesc

this.triggerKeyupEvent(seoDescInput)
this.toggleStateClass(true, seoDescAiElement, 'seo-ai-hidden')
},
applySeoKeywords: function () {
const seoKeywordsAiElement = document.querySelector('.js-ai-generated-seo-keywords')
const seoKeywordsInput = document.querySelector('.js-seo-textfield.js-seo-keywords')

seoKeywordsInput.value = productSeoAiAssistantHandler.generatedSeoKeywords.join(',')

this.triggerKeyupEvent(seoKeywordsInput)                                 ;
this.toggleStateClass(true, seoKeywordsAiElement, 'seo-ai-hidden')
},
toggleStateClass: function (condition, targetElement, className) {
const hasClass = Array.from(targetElement.classList).includes(className)

if(condition && !hasClass) {
targetElement.classList.add(className)
} else if(!condition && hasClass) {
targetElement.classList.remove(className)
}
},
triggerKeyupEvent: function (element) {
element.dispatchEvent(new KeyboardEvent('keyup'))
}
}

$(function() {
var $textfield = $('.js-seo-textfield'),
$title = $('.js-seo-title'),
$desc = $('.js-seo-desc'),
$cell = $('.js-seo-cell');

function toggleSeoPreview() {
var isFilled = true           ;

$textfield.each(function() {
if ($title.val() === '' && $desc.val() === '') {
isFilled = false                                 ;
}
})                                               ;

if (isFilled) {
$cell.show()    ;
} else {
$cell.hide()    ;
}
}

function updateSeoPreview($inputText) {
var value = $inputText.val(),
limitLength = $inputText.data('limit-length');

if (limitLength < value.length) {
value = value.substr(0, limitLength) + '...';
}

$('#' + $inputText.data('for')).text(value);
toggleSeoPreview()                           ;
}

function updateCharCounter($inputText) {
var currentCount = $inputText.val().length,
limitLength = $inputText.data('limit-length'),
$label = $inputText.nextAll('.js-seo-label');

$label.html('現在' + currentCount + '文字（' + limitLength + '文字以内推奨）');
}

$textfield.on('keyup', function() {
updateSeoPreview($(this))           ;
updateCharCounter($(this))          ;
}).trigger('keyup');
})                                  ;
</script>
