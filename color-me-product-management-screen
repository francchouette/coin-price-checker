toggleStateClass: function (condition, targetElement, className) {
const hasClass = Array.from(targetElement.classList).includes(className)

if(condition && !hasClass) {
targetElement.classList.add(className)
} else if(!condition && hasClass) {
targetElement.classList.remove(className)
}
},
generate: async function () {
const productNameElement = document.querySelector('[name="product_name"]')
const productExplElement = document.querySelector('[name="expl"]')
const aiMain = document.querySelector('.js-simple-expl-ai-main')

this.startWaitingAnimation()

const setGeneratedState = () => this.toggleStateClass(true, aiMain, 'ai-main--is-generated')
const setDoneState = () => this.toggleStateClass(false, aiMain, 'ai-main--is-generating')
const setGeneratingState = () => {
this.toggleStateClass(true, aiMain, 'ai-main--is-generating')
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
}

const handleError = text => {
alert(text)
setDoneState()
}

setGeneratingState()

const data = new FormData()
data.set('productName', productNameElement.value)
data.set('description', productExplElement.value)

let response = null
try {
response = await fetch(
'/?mode=generate_product_simple_expl',
{
method: 'POST',
body: data
}
)
} catch (e) {
handleError('ネットワークエラーが発生したため処理を中断しました。再度お試しください。')

throw e ;
}

const jsonResponse = await response.json()

if (response.status !== 200) {
const errorMessage = jsonResponse.title ? `エラーが発生しました。${jsonResponse.title}` : 'エラーが発生したため処理を中断しました。再度お試しください。';
handleError(errorMessage)                                                                                                                                                                          ;
return                                                                                                                                                                                             ;
}

document.querySelector('.ai-generated-expl').innerText = jsonResponse.message
this.generatedText = jsonResponse.message

setDoneState()
setGeneratedState()
},
applyText: function () {
const aiMain = document.querySelector('.js-simple-expl-ai-main')
const explTextArea = document.querySelector('[name="simple_expl"]')
explTextArea.value = `${this.generatedText}`
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
const event = new Event('input')
explTextArea.dispatchEvent(event)
document.getElementById('product-simple-expl').scrollIntoView({behavior: 'smooth'})
},
startWaitingAnimation: function () {
const waitingTextElement = document.querySelector('.ai-expl-waiting-text')
const splittedText = [...waitingTextElement.innerText]
waitingTextElement.textContent = ''
splittedText.forEach((char, i) => {
setTimeout(() => {
waitingTextElement.textContent += char                                              ;
}, 75 * ++i)                                                                        ;
})                                                                                  ;
},
adjustTone: async function () {
const aiMain = document.querySelector('.js-simple-expl-ai-main')

this.startWaitingAnimation()

const setGeneratedState = () => this.toggleStateClass(true, aiMain, 'ai-main--is-generated')
const setDoneState = () => this.toggleStateClass(false, aiMain, 'tone-adjustment-area--is-generating')
const setGeneratingState = () => {
this.toggleStateClass(true, aiMain, 'tone-adjustment-area--is-generating')
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
}

const handleError = text => {
alert(text)
setDoneState()
setGeneratedState()
}

setGeneratingState()

const generatedAiDescriptionText = document.querySelector('.ai-generated-expl').innerText
const token = document.getElementById('hidden_token').value;

const data = new FormData()
data.set('generatedAiDescription', generatedAiDescriptionText)
data.set('toneAdjustText', this.explToneAdjustText + '\nまた、出力は100文字程度にしてください')
data.set('t', token)                                                                                             ;

let response = null
try {
response = await fetch(
'/?mode=adjust_tone_generated_description',
{
method: 'POST',
body: data
}
)
} catch (e) {
handleError('ネットワークエラーが発生したため処理を中断しました。再度お試しください。')

throw e ;
}

const jsonResponse = await response.json()

if (response.status !== 200) {
const errorMessage = jsonResponse.title ? `エラーが発生しました。${jsonResponse.title}` : 'エラーが発生したため処理を中断しました。再度お試しください。';
handleError(errorMessage)                                                                                                                                                                          ;
return                                                                                                                                                                                             ;
}

document.querySelector('.ai-generated-expl').innerText = jsonResponse.message
this.generatedText = jsonResponse.message

setDoneState()
setGeneratedState()
}
}
