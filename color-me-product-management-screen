<script>
const productSeoAiAssistantHandler = {
generatedSeoTitle: '',
generatedSeoDesc: '',
generatedSeoKeywords: [],
init: function() {
const aiMain = document.querySelector('.js-product-seo-ai-main')
const aiAssistant = document.querySelector('.js-product-seo-ai-assistant')

const productNameElement = document.querySelector('[name="product_name"]')
const productExplElement = document.querySelector('[name="expl"]')

window.addEventListener('agreedAiAssistantTerms-productSeo', () => {
localStorage.setItem('isAgreedToAiAssistantTerms', true)
aiAssistant.classList.add('seo-ai-assistant--is-agreed')
// uikit_js に依存する処理なので、ここだけjQuery記述を許容する
uikit_js.toggleBoxHandler.showToggleBox($('.c-toggle-box[data-box-name="seo-ai-assistant-area"]'))
document.getElementById("seo-ai-assistant-toggle-button").classList.add('c-toggle-box-menu--active')
aiMain.scrollIntoView({behavior: 'smooth'})
})

this.toggleStateClass(
localStorage.getItem('isAgreedToAiAssistantTerms'),
aiAssistant,
'seo-ai-assistant--is-agreed'
)
this.toggleStateClass(
productNameElement.value && productExplElement.value,
aiMain,
'ai-main--has-product-name'
)
productNameElement.addEventListener('input', () => {
this.toggleStateClass(
productNameElement.value && productExplElement.value,
aiMain,
'ai-main--has-product-name'
)
})

productExplElement.addEventListener('input', () => {
this.toggleStateClass(
productNameElement.value && productExplElement.value,
aiMain,
'ai-main--has-product-name'
)
})
},
openAiAssistantTermsModal: function () {
window.dispatchEvent(new CustomEvent('openAiAssistantTermsModal-productSeo'))
},
toggleStateClass: function (condition, targetElement, className) {
const hasClass = Array.from(targetElement.classList).includes(className)

if(condition && !hasClass) {
targetElement.classList.add(className)
} else if(!condition && hasClass) {
targetElement.classList.remove(className)
}
},
generate: async function () {
const aiMain = document.querySelector('.js-product-seo-ai-main')
const generatingArea = document.querySelector('.js-product-seo-ai-main .generating-area')

const productNameElement = document.querySelector('[name="product_name"]')
const productExplElement = document.querySelector('[name="expl"]')

const seoTitleAiElement = document.querySelector('.js-ai-generated-seo-title')
const seoDescAiElement = document.querySelector('.js-ai-generated-seo-desc')
const seoKeywordsAiElement = document.querySelector('.js-ai-generated-seo-keywords')

this.startWaitingAnimation()

const setGeneratedState = () => {
this.toggleStateClass(true, aiMain, 'seo-ai-main--is-generated')

this.toggleStateClass(false, seoTitleAiElement, 'seo-ai-hidden');
this.toggleStateClass(false, seoDescAiElement, 'seo-ai-hidden');
this.toggleStateClass(false, seoKeywordsAiElement, 'seo-ai-hidden');
}
const setDoneState = () => this.toggleStateClass(false, aiMain, 'seo-ai-main--is-generating')
const setGeneratingState = () => {
this.toggleStateClass(true, aiMain, 'seo-ai-main--is-generating')
this.toggleStateClass(false, aiMain, 'seo-ai-main--is-generated')
}

const handleError = text => {
alert(text)
setDoneState()
}

setGeneratingState()

const data = new FormData()
data.set('productName', productNameElement.value)
data.set('productExpl', productExplElement.value)
data.set('t', document.querySelector('[name="t"]').value)

let response = null
try {
response = await fetch(
'/?mode=generate_product_seo',
{
method: 'POST',
body: data
}
)
} catch (e) {
handleError('ネットワークエラーが発生したため処理を中断しました。再度お試しください。')

throw e ;
}

if (response.status !== 200 && response.status !== 400) {
handleError('エラーが発生したため処理を中断しました。再度お試しください。')
return
}

const jsonResponse = await response.json()

if (response.status === 400 && jsonResponse.title) {
handleError(`エラーが発生しました。${jsonResponse.title}`)
return
}

const {title, description, keywords} = jsonResponse.message

this.generatedSeoTitle = title       ;
this.generatedSeoDesc = description  ;
this.generatedSeoKeywords = keywords ;

const seoTitleInput = document.querySelector('.js-seo-textfield.js-seo-title')
const seoDescInput = document.querySelector('.js-seo-textfield.js-seo-desc')
const seoKeywordsInput = document.querySelector('.js-seo-textfield.js-seo-keywords')

if (!seoTitleInput.value && !seoDescInput.value && !seoKeywordsInput.value) {
seoTitleInput.value = title
seoDescInput.value = description
seoKeywordsInput.value = keywords.join(',')

this.triggerKeyupEvent(seoTitleInput)
this.triggerKeyupEvent(seoDescInput)
this.triggerKeyupEvent(seoKeywordsInput)
} else {
document.querySelector('.js-ai-generated-seo-title .generating-area__text').innerText = `${title} (${title.length}文字)`            ;
document.querySelector('.js-ai-generated-seo-desc .generating-area__text').innerText = `${description} (${description.length}文字)` ;
document.querySelector('.js-ai-generated-seo-keywords .generating-area__text').innerText = keywords.join(',')

setGeneratedState()
}

setDoneState()
},
triggerKeyupEvent: function (element) {
element.dispatchEvent(new KeyboardEvent('keyup'))
},
startWaitingAnimation: function () {
const waitingTextElement = document.querySelector('.js-product-seo-ai-main .generating-area__waiting-text')

const splittedText = [...waitingTextElement.innerText]
waitingTextElement.textContent = ''
splittedText.forEach((char, i) => {
setTimeout(() => {
waitingTextElement.textContent += char                                                                                                                                                                                                                                         ;
}, 75 * ++i)                                                                                                                                                                                                                                                                   ;
})                                                                                                                                                                                                                                                                             ;
}
}
window.addEventListener('DOMContentLoaded', () => {
productSeoAiAssistantHandler.init()                                                                                                                                                                                                                                            ;
})
</script>
