<script type="text/javascript">
const productSeoFormHandler = {
applySeoTitle: function () {
const seoTitleAiElement = document.querySelector('.js-ai-generated-seo-title')
const seoTitleInput = document.querySelector('.js-seo-textfield.js-seo-title')

seoTitleInput.value = productSeoAiAssistantHandler.generatedSeoTitle

