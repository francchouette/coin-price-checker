<script>
let descriptionText = ''
let toneAdjustText = ''

document.getElementById('ai_assistant_keywords').addEventListener('cmsinput', e => descriptionText = e.detail.value)
let element = document.getElementById('ai_assistant_tone_adjustment');
if (element) {
element.addEventListener('cmsinput', e => toneAdjustText = e.detail.value)                                           ;
}

const productExplAiAssistantHandler = {
generatedText: '',
init: function() {
const productNameElement = document.querySelector('[name="product_name"]')
const aiMain = document.querySelector('.js-ai-main')
const aiAssistant = document.querySelector('.js-product-edt-ai-assistant')

window.addEventListener('agreedAiAssistantTerms-productExpl', () => {
localStorage.setItem('isAgreedToAiAssistantTerms', true)
aiAssistant.classList.add('product-edt-ai-assistant--is-agreed')
// uikit_js に依存する処理なので、ここだけjQuery記述を許容する
uikit_js.toggleBoxHandler.showToggleBox($('.c-toggle-box[data-box-name="ai-assistant-area"]'))
document.getElementById("ai-assistant-toggle-button").classList.add('c-toggle-box-menu--active')
aiMain.scrollIntoView({behavior: 'smooth'})
})

this.toggleStateClass(
localStorage.getItem('isAgreedToAiAssistantTerms'),
aiAssistant,
'product-edt-ai-assistant--is-agreed'
)
this.toggleStateClass(
productNameElement.value,
aiMain,
'ai-main--has-product-name'
)
productNameElement.addEventListener('input',() => {
this.toggleStateClass(
productNameElement.value,
aiMain,
'ai-main--has-product-name'
)
})
},
openAiAssistantTermsModal: function () {
window.dispatchEvent(new CustomEvent('openAiAssistantTermsModal-productExpl'));
},
toggleStateClass: function (condition, targetElement, className) {
const hasClass = Array.from(targetElement.classList).includes(className)

if(condition && !hasClass) {
targetElement.classList.add(className)
} else if(!condition && hasClass) {
targetElement.classList.remove(className)
}
},
generate: async function () {
const productNameElement = document.querySelector('[name="product_name"]')
const aiMain = document.querySelector('.js-ai-main')

if (!validCustomInput()) return

this.startWaitingAnimation()

const setGeneratedState = () => this.toggleStateClass(true, aiMain, 'ai-main--is-generated')
const setDoneState = () => this.toggleStateClass(false, aiMain, 'ai-main--is-generating')
const setGeneratingState = () => {
this.toggleStateClass(true, aiMain, 'ai-main--is-generating')
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
}

const handleError = text => {
alert(text)
setDoneState()
}

setGeneratingState()

const productName = productNameElement.value   ;
const productFeatureKeywords = descriptionText ;

let response = null
try {
response = await fetch(
'/?mode=generate_product_description',
{
method: 'POST',
headers: {
'Content-Type': 'application/json'
},
body: JSON.stringify({ productName, productFeatureKeywords })
}
)
} catch (e) {
handleError('ネットワークエラーが発生したため処理を中断しました。再度お試しください。')

throw e ;
}

const jsonResponse = await response.json()

if (response.status !== 200) {
const errorMessage = jsonResponse.title ? `エラーが発生しました。${jsonResponse.title}` : 'エラーが発生したため処理を中断しました。再度お試しください。';
handleError(errorMessage)                                                                                                                                                                          ;
return                                                                                                                                                                                             ;
}

document.querySelector('.generating-area__text--is-generated').innerText = jsonResponse.message
this.generatedText = jsonResponse.message

setDoneState()
setGeneratedState()
},
applyText: function () {
const aiMain = document.querySelector('.js-ai-main')
const explTextArea = document.querySelector('[name="expl"]')
explTextArea.value = `${this.generatedText}\n▲▲カラーミーAIアシスタント（β）が生成した文章です▲▲\n${explTextArea.value}`
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
const event = new Event('input')
explTextArea.dispatchEvent(event)
document.getElementById('product-edt-expl').scrollIntoView({behavior: 'smooth'})
},
startWaitingAnimation: function () {
const waitingTextElement = document.querySelector('.generating-area__waiting-text')
const splittedText = [...waitingTextElement.innerText]
waitingTextElement.textContent = ''
splittedText.forEach((char, i) => {
setTimeout(() => {
waitingTextElement.textContent += char                                                                                                                  ;
}, 75 * ++i)                                                                                                                                            ;
})                                                                                                                                                      ;
},
adjustTone: async function () {
const aiMain = document.querySelector('.js-ai-main')
const productNameElement = document.querySelector('[name="product_name"]')

this.startWaitingAnimation()

const setGeneratedState = () => this.toggleStateClass(true, aiMain, 'ai-main--is-generated')
const setDoneState = () => this.toggleStateClass(false, aiMain, 'tone-adjustment-area--is-generating')
const setGeneratingState = () => {
this.toggleStateClass(true, aiMain, 'tone-adjustment-area--is-generating')
this.toggleStateClass(false, aiMain, 'ai-main--is-generated')
}

const handleError = text => {
alert(text)
setDoneState()
setGeneratedState()
}

setGeneratingState()

const generatedAiDescriptionText = document.querySelector('.generating-area__text--is-generated').innerText
const token = document.getElementById('hidden_token').value;

const productName = productNameElement.value                                                                                ;
const generatedDescription = generatedAiDescriptionText                                                                     ;
const regenerateDescriptionInstruction = toneAdjustText                                                                     ;
const productFeatureKeywords = descriptionText                                                                              ;
let response = null
try {
response = await fetch(
'/?mode=generate_product_description',
{
method: 'POST',
body: JSON.stringify({ productName, generatedDescription, regenerateDescriptionInstruction, productFeatureKeywords})
}
)
} catch (e) {
handleError('ネットワークエラーが発生したため処理を中断しました。再度お試しください。')

throw e ;
}

const jsonResponse = await response.json()

if (response.status !== 200) {
const errorMessage = jsonResponse.title ? `エラーが発生しました。${jsonResponse.title}` : 'エラーが発生したため処理を中断しました。再度お試しください。';
handleError(errorMessage)                                                                                                                                                                          ;
return                                                                                                                                                                                             ;
}

document.querySelector('.generating-area__text--is-generated').innerText = jsonResponse.message
this.generatedText = jsonResponse.message

setDoneState()
setGeneratedState()
}
}
window.addEventListener('DOMContentLoaded', () => {
productExplAiAssistantHandler.init()                                                                                                                                                                                                     ;
})
</script>
